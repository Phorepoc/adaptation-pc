#!/bin/sh
# Copyright The Phorepoc Authors
# SPDX-License-Identifier: BSD-2-Clause
# /etc/grub.d/45_phorepoc -- the GPD Win 2 rig's Phorepoc entry (phorepoc-stage picks it with grub-reboot). The ISO's
# grub.cfg boot (multiboot2) plus what a distro's GRUB does not load by itself: the GOP video driver, a kept graphics
# mode for the multiboot2 framebuffer tag, and the modules to find the ESP.
exec tail -n +8 $0
menuentry "Phorepoc x86_64 (disk)" {
    insmod part_gpt
    insmod fat
    insmod efi_gop
    insmod all_video
    insmod multiboot2
    search --no-floppy --set=root --file /phorepoc/phorepoc.elf
    set gfxpayload=keep
    multiboot2 /phorepoc/phorepoc.elf
    boot
}
