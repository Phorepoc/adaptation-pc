#
# phorepoc-stage -- at every Linux boot on the GPD Win 2 rig (phorepoc-stage.service, after phorepoc-collect): fetch the
# lab's image, http://$LAB/gpd/phorepoc.elf. If it is new (sha256 differs from the last one booted) or
# /var/lib/phorepoc/rearm exists, put it on the PHBOOT partition (\boot\phorepoc.elf: the release ISO's own GRUB and
# grub.cfg, copied file for file, the same boot the VMs get) and boot that partition ONCE through UEFI BootNext. The boot
# order is untouched, so whatever happens in Phorepoc, the boot after it is Linux again (a crash reset, the watchdog, or
# a power cycle). Settings: /etc/default/phorepoc-rig (LAB=host:port).
set -u
LAB=192.168.1.79:8737
ENTRY="Phorepoc ISO boot"
[ -f /etc/default/phorepoc-rig ] && . /etc/default/phorepoc-rig
S=/var/lib/phorepoc; mkdir -p "$S"
DEV=$(blkid -L PHBOOT 2>/dev/null) || { echo "phorepoc-stage: no PHBOOT partition (setup-linux.sh)"; exit 1; }
num=$(efibootmgr | awk -v e="$ENTRY" '$1 ~ /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]\*?$/ {
  n = substr($1, 5, 4); l = $0; sub(/^[^ \t]+[ \t]+/, "", l); if (index(l, e) == 1) { print n; exit } }')
[ -n "$num" ] || { echo "phorepoc-stage: no UEFI entry \"$ENTRY\" (setup-linux.sh)"; exit 1; }
T=$(mktemp)
if ! curl -fsS --max-time 60 -o "$T" "http://$LAB/gpd/phorepoc.elf"; then
  echo "phorepoc-stage: no image at http://$LAB/gpd/phorepoc.elf"; rm -f "$T"; exit 0
fi
new=$(sha256sum "$T" | cut -c1-64)
old=$(cat "$S/booted.sha" 2>/dev/null || true)
if [ "$new" = "$old" ] && [ ! -e "$S/rearm" ]; then
  echo "phorepoc-stage: image $new booted already (touch $S/rearm to boot it again)"; rm -f "$T"; exit 0
fi
M=$(mktemp -d)
mount "$DEV" "$M" || { echo "phorepoc-stage: cannot mount $DEV"; rm -f "$T"; exit 1; }
cp "$T" "$M/boot/phorepoc.elf.new" && sync && mv "$M/boot/phorepoc.elf.new" "$M/boot/phorepoc.elf" && sync
umount "$M"; rmdir "$M"; rm -f "$T" "$S/rearm"
echo "$new" > "$S/booted.sha"
date +%s > "$S/attempt"										# phorepoc-collect: a boot was tried
efibootmgr -q -n "$num" || { echo "phorepoc-stage: BootNext $num failed"; exit 1; }
echo "phorepoc-stage: booting Phorepoc $new (Boot$num, once)"
[ "${NOREBOOT:-0}" = 1 ] || systemctl reboot
