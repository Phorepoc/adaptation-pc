TARGET			phelandtest.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157E9
EPOCSTACKSIZE	0x10000
CAPABILITY		All -TCB
VENDORID		0

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
SOURCEPATH		.
